# Entity: engagement

main: kit: entity: engagement: {

  alias: field: {}

  fields: [
    {
      name: "action"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Type of engagement requested"
      type: "`$STRING`"
    }
    {
      name: "estimated_completion"
      req: false
      short: "Estimated time to complete the request"
      type: "`$STRING`"
    }
    {
      name: "quantity"
      req: false
      short: "Number of engagements being processed"
      type: "`$INTEGER`"
    }
    {
      name: "request_id"
      req: false
      short: "Unique identifier for tracking the request"
      type: "`$STRING`"
    }
    {
      name: "url"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Target TikTok URL"
      type: "`$STRING`"
    }
  ]

  name: "engagement"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/engagement"
          parts: [
            "api"
            "engagement"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
